# Copy to pgwriter.env and fill in the real password:
#     cp deploy/pgwriter.env.example deploy/pgwriter.env
#
# Load it before running:
#     set -a; source deploy/pgwriter.env; set +a; ./pgwriter
#
# pgwriter.env is gitignored (deploy/*.env) -- the password never enters git.
# This .example file is committed and must stay free of real credentials.

CONSUMER_GROUP=pg-writer

# Minutes added to gps_time when picking the monthly table (India = 330).
PGWRITER_UTC_OFFSET=330

# Kafka is bound to 127.0.0.1 on the prod box and pgwriter runs on that same
# host, so "localhost" is correct in BOTH environments.
KAFKA_BROKERS=localhost:9092

# ===========================================================================
# POSTGRES -- exactly ONE of the two blocks below may be active.
# ===========================================================================

# ---- PRODUCTION (atlvm-6 / 103.114.154.161) --------------------------------
# Postgres there listens on 192.168.23.135 ONLY, never on localhost, so a
# "localhost" DSN fails on that box. Role is `newtrack`, not `postgres`.
# The password contains '&', which MUST be percent-encoded as %26 because a
# DSN is a URL.
POSTGRES_DSN=postgres://newtrack:REPLACE_WITH_PASSWORD@192.168.23.135:5432/atltracking

# ---- LOCAL DEV -- comment the line above, uncomment the line below ---------
#POSTGRES_DSN=postgres://postgres:root@localhost:5432/atltracking
